# Copie para .env (local) ou cadastre em Vercel > Settings > Environment Variables.
# NUNCA faça commit dos valores reais.

# Login (Google Workspace): só entram e-mails dos domínios liberados
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# texto aleatório com 32+ caracteres; trocar derruba todas as sessões
AUTH_SECRET=
# AUTH_ALLOWED_DOMAINS=vissimo.com.br,evino.com.br,grandcru.com.br

# Redshift (use um usuário de serviço só leitura)
REDSHIFT_HOST=
REDSHIFT_PORT=5439
REDSHIFT_DATABASE=
REDSHIFT_USER=
REDSHIFT_PASSWORD=
# REDSHIFT_SSL=false   # só se o cluster não aceitar SSL

# Google Sheets: JSON inteiro da conta de serviço, numa linha.
# Compartilhe a planilha Monitoramento de Canais e os arquivos do Plano de Vendas com o client_email dela.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Meta Ads: token de usuário de sistema do Business Manager com ads_read
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=775254035944122

# Insider One: chave INS.… do painel do Insider One, com acesso às APIs de relatório de e-mail e WhatsApp
INSIDER_API_KEY=
# INSIDER_WHATSAPP_KEY=   # só se o WhatsApp usar outra chave

# Opcionais: trocar tabelas do Redshift sem mexer no código
# T_FACT_ORDER_ITEM=dora_red_aggregations.ev_fact_order_item
# T_LAST_CLICK=vissimo_bi.vw_ev_last_click_pedido
# T_LAST_CLICK_RAW=dora_red_aggregations.ev_last_click_full        # reserva sem permissão na view (desduplicada)
# T_DIM_BUNDLE=dora_red_aggregations.vw_ev_dim_product_bundle
# T_GRUPO_PRODUTO=dora_red_aggregations.vw_carga_ev_grupo_de_produto
# T_GRUPO_PRODUTO_RAW=dora_red_aggregations.ev_grupo_de_produto     # reserva sem permissão na view (carga mais recente)
# T_DIM_PRODUCT=dora_red_aggregations.ev_dim_product
